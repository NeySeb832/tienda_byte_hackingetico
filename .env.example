# =============================================================================
# Byte — variables de entorno (desarrollo local).
# Copia este archivo a .env y completa los valores. NUNCA subas .env al repositorio.
# Producción: ver docs/despliegue.md (Fase 9).
# =============================================================================

# Clave secreta de Django (obligatoria). Genérala con:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=

DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
DJANGO_LOG_LEVEL=INFO
DJANGO_DEBUG_TOOLBAR=false

# Ruta oculta del admin de Django (solo superadmin). Vacía = admin deshabilitado.
# Debe ser un único segmento terminado en "/". Genérala con:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(18) + '/')"
DJANGO_ADMIN_URL=

# --- PostgreSQL --------------------------------------------------------------
# docker compose usa POSTGRES_*; Django usa DATABASE_URL (mismos valores).
POSTGRES_DB=byte
POSTGRES_USER=byte
POSTGRES_PASSWORD=
DATABASE_URL=postgres://byte:CAMBIA_ESTA_CLAVE@localhost:5432/byte

# --- Valkey / Redis (caché, sesiones, broker de Celery) ------------------------
REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_TASK_ALWAYS_EAGER=false

# --- Correo --------------------------------------------------------------------
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_DEFAULT_FROM_EMAIL=Byte <no-reply@byte.localhost>

# --- Cifrado de campos sensibles (documento, teléfono) — obligatorio -----------
# Claves Fernet separadas por coma; la primera cifra, todas descifran (rotación). Genérala con:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BYTE_FIELD_ENCRYPTION_KEYS=
# Clave HMAC para buscar por documento sin descifrar (blind index):
#   uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
BYTE_BLIND_INDEX_KEY=

# --- CAPTCHA (Cloudflare Turnstile). Vacío = claves públicas de prueba (solo desarrollo)
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
BYTE_CAPTCHA_ENABLED=true
# Fallos de inicio de sesión antes de exigir CAPTCHA (0 = siempre; producción usa 0).
# BYTE_LOGIN_CAPTCHA_AFTER_FAILURES=3

# --- IP del cliente tras proxies (ADR-0018). Sin valor = REMOTE_ADDR (solo desarrollo).
# Cabecera de un borde que el cliente no puede saltarse (Render/Cloudflare: HTTP_CF_CONNECTING_IP).
# BYTE_CLIENT_IP_HEADER=
# Sin Cloudflare: saltos de confianza contados desde la derecha de X-Forwarded-For.
# BYTE_TRUSTED_PROXY_COUNT=0
BYTE_HIBP_ENABLED=true
BYTE_STAFF_IDLE_TIMEOUT_MINUTES=15
# Contraseña de los usuarios de demostración (seed_demo_users). Con DEBUG=False el personal
# demo no recibe el secreto TOTP público: activa su propio autenticador al primer ingreso.
BYTE_DEMO_PASSWORD=

# --- Parámetros de negocio -----------------------------------------------------
BYTE_HIGH_DISCOUNT_APPROVAL_PCT=15
BYTE_STOCK_RESERVATION_TTL_MINUTES=15

# --- Solo producción (ver docs/despliegue.md) -----------------------------------
# DJANGO_USE_S3=true
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_ENDPOINT_URL=https://<cuenta>.r2.cloudflarestorage.com
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# DJANGO_ANYMAIL={"BREVO_API_KEY": "..."}
# SENTRY_DSN=

# --- Checkout y pagos (Fase 4, ADR-0007) ---
# URL pública del sitio (enlaces en los correos).
BYTE_SITE_URL=http://localhost:8000
# fake = simulador interno sin red (desarrollo); wompi = sandbox de Wompi.
BYTE_PAYMENT_GATEWAY=fake
# Llaves del sandbox de Wompi (comercios.wompi.co → Desarrolladores). Nunca las de producción.
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
WOMPI_API_URL=https://sandbox.wompi.co/v1
WOMPI_CHECKOUT_URL=https://checkout.wompi.co/p/
